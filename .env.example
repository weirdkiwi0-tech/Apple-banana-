# 실제 값은 커밋 금지. 프로덕션 비밀값은 Vercel 환경변수로 설정하세요.
# 로컬 개발·테스트용 SQLite
DATABASE_URL="file:./data/app.db"
# Neon PostgreSQL 배포용 (connection pooling URL과 direct/unpooled URL)
# DATABASE_URL="postgresql://..."
# DIRECT_URL="postgresql://..."
TEACHER_PASSCODE=""
SESSION_SECRET=""
SESSION_HOURS="12"
TZ="Asia/Seoul"
NODE_ENV="development"
